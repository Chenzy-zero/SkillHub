{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/localization-result.schema.json",
  "title": "Report zh-CN localization result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "locale",
    "translator",
    "translations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^localization-[0-9a-f]{32}$"
    },
    "locale": {
      "const": "zh-CN"
    },
    "translator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model"],
      "properties": {
        "kind": {
          "const": "AI"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "translation_key",
          "source_sha256",
          "translated_text"
        ],
        "properties": {
          "translation_key": {
            "type": "string",
            "pattern": "^translation-[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "translated_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    }
  }
}
