#!/usr/bin/env bash
set -euo pipefail

# POC wrapper for Gerrit's hooks plugin `patchset-created` hook.
# Adjust these paths for your Gerrit deployment.
POC_HOME="${SKILL_POC_HOME:-/opt/skillhub-poc}"
GIT_BASE="${SKILL_POC_GIT_BASE:-/var/gerrit/review_site/git}"
OUTPUT="${SKILL_POC_OUTPUT:-/var/gerrit/review_site/logs/skill-poc.jsonl}"

exec python3 "${POC_HOME}/gerrit_hook.py" \
  --repo-base "${GIT_BASE}" \
  --output-file "${OUTPUT}" \
  "$@"
